# Required
DATABASE_URL=postgres://localhost/sf_pulse_db

# Server
HOST=127.0.0.1
PORT=5000
APP_URL=http://127.0.0.1:5000

# Web push notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Protects mutation endpoints (any random string locally)
CRON_SECRET=

# Optional: Redis-backed realtime fanout across instances
REDIS_URL=redis://127.0.0.1:6379

# Required for menu and article parsing
# Get key at platform.openai.com — see docs/openai-api-permissions.md for required permissions
OPENAI_API_KEY=

# Cron service only (not needed for web or workflow)
RENDER_API_KEY=
SF_PULSE_WORKFLOW_SLUG=
