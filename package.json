{
  "name": "sf-pulse",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "tsx bin/build.ts",
    "migrate": "tsx bin/migrate.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "node --import tsx/esm --test $(find server -name '*.test.ts' | sort | tr '\n' ' ')"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.60.5",
    "express": "^5.0.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7",
    "wouter": "^3.3.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "20.19.27",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.0",
    "patch-package": "^8.0.1",
    "pg-mem": "^3.0.14",
    "supertest": "^7.2.2",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "vite": "^7.3.0"
  }
}
