---
import "../styles/global.css";
import "../styles/home.css";
import scriptUrl from "../scripts/home.ts?url";
import { serializeForInlineScript } from "../../server/security.js";
import { getInitialData } from "../server/api/utils.js";
import {
  DIETARY_FLAG_DEFINITIONS,
  formatEventCategory,
  getEventCategoryOptions,
  getRestaurantCuisineOptions,
  getRestaurantNeighborhoodOptions,
} from "../../shared/catalog.ts";
import { applyEventFilters, applyRestaurantFilters, parseHomeFilters } from "../../shared/filters.ts";
import { renderEventTableBody, renderRestaurantTableBody } from "../../shared/render.ts";

export const prerender = false;

const data = await getInitialData();
const filters = parseHomeFilters(Astro.url.searchParams);
const filteredRestaurants = applyRestaurantFilters(data.restaurants, filters.restaurants);
const filteredEvents = applyEventFilters(data.events, filters.events);
const lastUpdated = data.lastUpdated
  ? new Date(data.lastUpdated).toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
    })
  : null;
const pageData = serializeForInlineScript(data);
const restaurantNeighborhoodOptions = getRestaurantNeighborhoodOptions(data.restaurants);
const restaurantCuisineOptions = getRestaurantCuisineOptions(data.restaurants);
const eventCategoryOptions = getEventCategoryOptions(data.events);

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1" />
    <title>SF Pulse — New Restaurants & Mission Events</title>
    <meta
      name="description"
      content="Track new San Francisco restaurant openings and upcoming Mission District events. Updated daily."
    />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#171614" />
    <link rel="icon" type="image/png" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="alternate" type="application/rss+xml" title="SF Pulse" href="/api/rss.xml" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page">
      <header class="header">
        <div class="headerInner">
          <div class="logo">
            <div class="logoMark">SF</div>
            <div>
              <div class="siteTitle">SF Pulse</div>
              <div class="siteSubtitle">New restaurants &amp; Mission District events</div>
            </div>
          </div>
          <div class="headerActions">
            <a class="iconBtn" href="/map" aria-label="Neighborhood map">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                <line x1="8" y1="2" x2="8" y2="18"></line>
                <line x1="16" y1="6" x2="16" y2="22"></line>
              </svg>
            </a>
            <button
              class="iconBtn"
              type="button"
              data-push-button
              hidden
              aria-label="Push notifications unavailable"
              aria-expanded="false"
              aria-controls="push-preferences"
            ></button>
          </div>
        </div>
        <section class="pushPanel" id="push-preferences" data-push-panel hidden>
          <div class="pushPanelHeader">
            <div>
              <h2 class="pushPanelTitle">Personalized alerts</h2>
              <p class="pushPanelMeta">
                Save neighborhoods, cuisines, dietary flags, and event categories for push delivery.
              </p>
            </div>
          </div>

          <div class="pushBanner" data-push-banner hidden>
            <strong>Notifications:</strong>
            On desktop, tap the bell and allow browser notifications. On iPhone or iPad, add SF Pulse to your Home
            Screen first, then enable alerts from the bell.
          </div>

          <div class="pushGrid">
            <section class="pushGroup">
              <h3>Neighborhoods</h3>
              <div class="chipRow">
                {restaurantNeighborhoodOptions.map((value) => (
                  <button
                    type="button"
                    class="chip"
                    data-push-chip
                    data-field="neighborhoods"
                    data-value={value}
                  >
                    {value}
                  </button>
                ))}
              </div>
            </section>

            <section class="pushGroup">
              <h3>Cuisines</h3>
              <div class="chipRow">
                {restaurantCuisineOptions.map((value) => (
                  <button
                    type="button"
                    class="chip"
                    data-push-chip
                    data-field="cuisines"
                    data-value={value}
                  >
                    {value}
                  </button>
                ))}
              </div>
            </section>

            <section class="pushGroup">
              <h3>Dietary flags</h3>
              <div class="chipRow">
                {DIETARY_FLAG_DEFINITIONS.map((diet) => (
                  <button
                    type="button"
                    class="chip"
                    data-push-chip
                    data-field="dietary_flags"
                    data-value={diet.key}
                  >
                    {diet.label}
                  </button>
                ))}
              </div>
            </section>

            <section class="pushGroup">
              <h3>Event categories</h3>
              <div class="chipRow">
                {eventCategoryOptions.map((value) => (
                  <button
                    type="button"
                    class="chip"
                    data-push-chip
                    data-field="event_categories"
                    data-value={value}
                  >
                    {formatEventCategory(value)}
                  </button>
                ))}
              </div>
            </section>
          </div>

          <div class="pushPanelActions">
            <button class="pushSecondaryAction" type="button" data-push-reset>Reset filters</button>
            <div class="pushPrimaryActions">
              <button class="pushSecondaryAction" type="button" data-push-disable hidden>Disable alerts</button>
              <button class="pushPrimaryAction" type="button" data-push-save>Enable alerts</button>
            </div>
          </div>
        </section>
      </header>

      <main class="main">
        <div class="tabsRow">
          <nav class="tabs" aria-label="Content sections">
            <a class="tab tabRestaurants" href="#restaurants">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"></path>
                <path d="M7 2v20"></path>
                <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3zm0 0v7"></path>
              </svg>
              Restaurants
            </a>
            <a class="tab tabEvents" href="#events">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              Events
            </a>
            <a class="tab tabDiagram" href="#diagram">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="6" cy="6" r="3"></circle>
                <circle cx="18" cy="6" r="3"></circle>
                <circle cx="12" cy="18" r="3"></circle>
                <line x1="6" y1="9" x2="12" y2="15"></line>
                <line x1="18" y1="9" x2="12" y2="15"></line>
              </svg>
              Diagram
            </a>
          </nav>
          <span class="tabsClock" hidden={!lastUpdated}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            Last updated:
            <span data-last-updated>{lastUpdated}</span>
          </span>
        </div>

        <section class="section restaurantsSection" id="restaurants">
          <div class="sectionHeader">
            <div>
              <h2 class="sectionTitle">New SF Restaurants</h2>
              <p class="sectionMeta">
                Recent openings, upcoming spots, and Michelin stars —
                <span data-count="restaurants">{filteredRestaurants.length}</span>
                shown
              </p>
            </div>
            <input
              type="search"
              class="filter"
              placeholder="Filter by name, address, area, cuisine…"
              aria-label="Filter restaurants"
              data-filter-input="restaurants"
              value={filters.restaurants.query}
            />
          </div>

          <div class="tableCard">
            <div class="timelineScroll" data-scroll-container="restaurants">
              <table>
                <thead>
                  <tr>
                    <th>Name</th>
                    <th class="colNeighborhood">Neighborhood</th>
                    <th class="colCuisine">Cuisine</th>
                    <th class="colDiet">Diet</th>
                    <th>Opened</th>
                  </tr>
                </thead>
                <tbody data-table-body="restaurants" set:html={renderRestaurantTableBody(filteredRestaurants)}></tbody>
              </table>
              <p class="empty" data-empty="restaurants" hidden={filteredRestaurants.length !== 0}>
                No restaurants match your filter.
              </p>
            </div>
          </div>
        </section>

        <section class="section eventsSection" id="events">
          <div class="sectionHeader">
            <div>
              <h2 class="sectionTitle">Mission District Events</h2>
              <p class="sectionMeta">
                Events in and around the Mission —
                <span data-count="events">{filteredEvents.length}</span>
                shown
              </p>
            </div>
            <input
              type="search"
              class="filter"
              placeholder="Filter by title, location, or category…"
              aria-label="Filter events"
              data-filter-input="events"
              value={filters.events.query}
            />
          </div>

          <div class="tableCard">
            <div class="timelineScroll" data-scroll-container="events">
              <table>
                <thead>
                  <tr>
                    <th>Event</th>
                    <th class="colNeighborhood">Neighborhood</th>
                    <th class="colCuisine">Category</th>
                    <th class="colTime">Time</th>
                    <th>Date</th>
                  </tr>
                </thead>
                <tbody data-table-body="events" set:html={renderEventTableBody(filteredEvents)}></tbody>
              </table>
              <p class="empty" data-empty="events" hidden={filteredEvents.length !== 0}>
                No events match your filter.
              </p>
            </div>
          </div>
        </section>

        <section class="section diagramSection" id="diagram">
          <div class="sectionHeader">
            <div>
              <h2 class="sectionTitle">Workflow Diagram</h2>
              <p class="sectionMeta">
                Daily refresh pipeline -> bin/workflow/daily-refresh.ts
              </p>
            </div>
          </div>
          <div class="diagramFrameWrap">
            <iframe
              class="diagramFrame"
              src="/diagram"
              title="Daily refresh workflow diagram"
              loading="lazy"
            ></iframe>
          </div>
        </section>

      </main>

      <div class="toastRegion" aria-live="polite" data-toast-region></div>
    </div>

    <script is:inline type="application/json" id="sf-pulse-data" set:html={pageData}></script>
    <script is:inline type="module" src={scriptUrl}></script>
  </body>
</html>
